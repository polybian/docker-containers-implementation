# Demo values — copy to `.env` and fill in. NEVER commit the real `.env`
# (it is in .gitignore). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- postgres (read by the db service via env_file) ---
POSTGRES_USER=<generate-your-own>
POSTGRES_PASSWORD=<generate-your-own>
POSTGRES_DB=demodb

# --- app ---
APP_PORT=8000
