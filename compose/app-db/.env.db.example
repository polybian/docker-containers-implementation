# DB secrets — copy to `.env.db` and fill in. NEVER commit the real `.env.db`
# (it is in .gitignore). Generate the password with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Read ONLY by the db service. The app never sees these values.

POSTGRES_USER=<generate-your-own>
POSTGRES_PASSWORD=<redacted>
POSTGRES_DB=demodb
