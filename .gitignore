# Never commit real secrets or local state.
# .env.example files are committed intentionally; real .env files are not.

# Real environment files (placeholders in *.example are fine)
.env
.env.app
.env.db
*.env
!.env.example
!.env.app.example
!.env.db.example

# Exported logs and generated reports
*.log
report*.txt

# Python bytecode / caches
__pycache__/
*.py[cod]

# Local data dirs (bind-mounted scratch, dumps, backups)
data/
backups/
dumps/

# OS noise
.DS_Store
